# Boutique Catálogo - Environment Variables
# Copy this file to .env.local and fill in your values

# Application
VITE_APP_NAME="Boutique Catálogo"
VITE_APP_VERSION="1.0.0"
VITE_SITE_URL="https://boutique-catalogo.com"
VITE_CONTACT_WHATSAPP="+34600000000"
VITE_CONTACT_EMAIL="info@boutique-catalogo.com"

# Analytics (optional)
VITE_GA_ID=""
VITE_HOTJAR_ID=""

# Feature Flags
VITE_ENABLE_ANIMATIONS=true
VITE_ENABLE_VIDEO_AUTOPLAY=true